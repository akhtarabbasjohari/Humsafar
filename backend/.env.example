# Django Security & Core
DJANGO_SECRET_KEY=change-this-in-production-secret-key-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Defaults to SQLite if omitted)
# DB_ENGINE=postgresql
# DB_NAME=humsafar
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432

# Decoupled Source Website Configuration (WordPress Live Site)
# Configure here to adapt to domain migrations without touching application code
SOURCE_SITE_URL=https://itp.7scribes.com
COMPANY_SITE_URL=https://itp.7scribes.com

# LLM Providers
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Search MCP Providers (SerpAPI, Tavily, or Brave Search)
SERP_API_KEY=your_serpapi_key_here
TAVILY_API_KEY=your_tavily_key_here
BRAVE_API_KEY=your_brave_key_here
